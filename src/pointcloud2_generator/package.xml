<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pointcloud2_generator</name>
  <version>0.1.0</version>
  <description>Universal PointCloud2 generator for ROS 2, builds combined point clouds from a scene file describing multiple shapes (sphere, cuboid, cylinder, cone, pyramid).</description>
  <maintainer email="ralf_brandt@outlook.com">Ralf Brandt</maintainer>
  <license>Apache-2.0</license>
  
  <!--buildtool_depend>ament_python</buildtool_depend-->
  
  <!-- Runtime dependencies: needed whenever the node is actually run -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Test-only dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>